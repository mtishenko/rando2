# Your ConnectWise API host (not your login URL). Cloud regions:
#   api-na.myconnectwise.net | api-eu.myconnectwise.net | api-au.myconnectwise.net
# On-prem: your server's hostname.
CW_SITE=api-na.myconnectwise.net
# Company ID you enter on the PSA login screen
CW_COMPANY_ID=yourcompany
# API Member keys (System > Members > API Members > API Keys)
CW_PUBLIC_KEY=
CW_PRIVATE_KEY=
# Free GUID from https://developer.connectwise.com/ClientID
CW_CLIENT_ID=
# Optional
# CW_CODEBASE=v4_6_release/
# CW_API_VERSION=2022.1
