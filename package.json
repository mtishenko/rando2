  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "5.7.3",
    "vitest": "3.0.4"
  }
}
